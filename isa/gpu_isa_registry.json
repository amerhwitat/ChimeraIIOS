    },
    {
      "id": "qualcomm-adreno",
      "vendor": "Qualcomm",
      "kind": "machine-isa",
      "reference": "Adreno generation-specific",
      "execution": "Vulkan/OpenCL driver",
      "status": "catalogued-not-emulated"
    }
  ],
  "dispatch": {
    "probe_device_vendor_and_features": true,
    "never_execute_gpu_binary_on_cpu": true,
    "compile_source_for_selected_target": true,
    "validate_shader_abi": true,
    "fallback_only_when_semantically_supported": true
  }
}
