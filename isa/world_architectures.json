  "research_policy": {
    "date": "2026-10-10",
    "note": "Builds perform bounded recursive source discovery. Catalog-only means source/inventory presence only; do not infer encoder, decoder, compiler, emulator, hardware, or boot support. Discovered TableGen identifiers are unverified candidates and remain separate from executable instruction forms.",
    "processor_families": [
      "x86 / x86-64",
      "Arm / AArch32 / AArch64",
      "RISC-V",
      "MIPS",
      "Power ISA / PowerPC",
      "SPARC",
      "LoongArch",
      "Xtensa",
      "AVR",
      "SuperH",
      "OpenRISC"
    ],
    "crawler": "tools/isa/research_catalog.py",
    "build_integration": "build-chimera-iso.sh",
    "online_by_default": true,
    "offline_option": "--offline-isa-research",
    "candidate_policy": "Research candidate identifiers are kept outside executable instruction rows until checked against normative specifications and tests."
  },
