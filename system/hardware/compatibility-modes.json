{
  "version": 3,
  "policy": "native-abi-over-koronos",
  "targets": {
    "native": {
      "architectures": [
        "x86_64",
        "aarch64",
        "riscv64"
      ],
      "execution": "native-or-emulated",
      "preferred_nbit": "hardware-best",
      "ipc": "mixed-width"
    },
    "windows": {
      "architectures": [
        "x86",
        "x86_64",
        "aarch64"
      ],
      "execution": "win32-nt-abi",
      "preferred_nbit": [
        32,
        64
      ],
      "ipc": "mixed-width"
    },
    "linux": {
      "architectures": [
        "x86",
        "x86_64",
        "aarch64",
        "riscv64"
      ],
      "execution": "posix-linux-abi",
      "preferred_nbit": [
        32,
        64
      ],
      "ipc": "mixed-width"
    },
    "bsd": {
      "architectures": [
        "x86",
        "x86_64",
        "aarch64",
        "riscv64"
      ],
      "execution": "posix-bsd-abi",
      "preferred_nbit": [
        32,
        64
      ],
      "ipc": "mixed-width"
    },
    "darwin": {
      "architectures": [
        "x86_64",
        "aarch64"
      ],
      "execution": "darwin-abi",
      "preferred_nbit": [
        64
      ],
      "ipc": "mixed-width"
    },
    "android": {
      "architectures": [
        "aarch64",
        "x86_64"
      ],
      "execution": "android-abi",
      "preferred_nbit": [
        64
      ],
      "ipc": "mixed-width"
    },
    "ios": {
      "architectures": [
        "aarch64"
      ],
      "execution": "ios-abi",
      "preferred_nbit": [
        64
      ],
      "ipc": "mixed-width"
    }
  },
  "wide_chimera_modes": [
    128,
    256,
    512,
    1024,
    2048,
    4096,
    8192
  ],
  "communication": {
    "rule": "all-processes-use-width-neutral-ipc",
    "endianness": "canonical-little-endian",
    "payload_limit_bytes": 16777216
  },
  "hosted_edition": {
    "enabled": true,
    "minimum_pointer_bits": 64,
    "runtime": "tools/runtime/chimera-hosted.py",
    "modes": {
      "windows": {
        "host_oses": [
          "Windows 10/11 x64",
          "Windows Server x64"
        ],
        "abi": "Win32/NT",
        "isa_candidates": [
          "x86-64",
          "armv9-a64"
        ],
        "desktop_bridge": "host file/URL opener and process launcher; Aurora GUI is separate"
      },
      "linux": {
        "host_oses": [
          "64-bit Linux"
        ],
        "abi": "Linux/POSIX",
        "isa_candidates": [
          "x86-64",
          "armv9-a64",
          "riscv64"
        ],
        "desktop_bridge": "xdg-open when available"
      },
      "unix": {
        "host_oses": [
          "64-bit BSD/POSIX"
        ],
        "abi": "POSIX/BSD",
        "isa_candidates": [
          "x86-64",
          "armv9-a64",
          "riscv64"
        ],
        "desktop_bridge": "platform opener where available"
      },
      "darwin": {
        "host_oses": [
          "64-bit macOS Intel/Apple Silicon"
        ],
        "abi": "Darwin/POSIX",
        "isa_candidates": [
          "x86-64",
          "armv9-a64"
        ],
        "desktop_bridge": "open command"
      }
    },
    "command_bridge": "portable built-ins plus small command alias table; no shell interpolation, pipelines or redirection",
    "isa_mapping_policy": "host architecture aliases resolve to canonical ISA database IDs; inventory matches do not imply emulation or compiler support",
    "limitations": [
      "not a hypervisor",
      "not a full syscall/API compatibility layer",
      "cross-ISA guest execution requires a separately validated backend"
    ]
  }
}
