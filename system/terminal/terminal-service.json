{
  "version": 1,
  "service": "chimera-terminald",
  "transport": "unix",
  "socket": "/run/chimera/terminald.sock",
  "authentication": {
    "mode": "bearer",
    "token_file": "/etc/chimera/terminal/auth.token",
    "minimum_permissions": [
      "terminal.create"
    ]
  },
  "sandbox": {
    "required": true,
    "backend_preference": [
      "bubblewrap",
      "unshare"
    ],
    "allow_unsafe_host": false,
    "root": "/var/lib/chimera/sandboxes"
  },
  "limits": {
    "cpu_seconds": 3600,
    "address_space_bytes": 2147483648,
    "file_size_bytes": 536870912,
    "open_files": 512,
    "processes": 128,
    "wall_seconds": 28800
  },
  "databases": {
    "engine": "sqlite3",
    "per_session": true,
    "path": "data/chimera.sqlite3",
    "extensions": false
  },
  "clients": [
    "aurora",
    "native-ide",
    "chimera-terminal",
    "chimera-sql"
  ]
}
