{
  "schema": "CHIMERA-DATABASE-BUILD-MATRIX-1",
  "policy": "Registry presence is not proof of build, bundle, or runtime support. CI builds the native Koronos-facing adapter, validates provenance, and acquires explicitly pinned upstream images.",
