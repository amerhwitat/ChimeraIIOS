{
  "schema": "chimera.installer.plan",
  "version": 1,
  "bootModes": [
    "spitfire",
    "grub2-multiboot2",
    "lilo-compat",
    "linux-chainload",
    "windows-chainload"
  ],
  "media": [
    "iso",
    "usb",
    "live-dvd",
    "disk"
  ],
  "targets": [
    "ssd",
    "nvme",
    "hdd"
  ],
  "partitionTables": [
    "gpt",
    "mbr"
  ],
  "ui": {
    "mouse": true,
    "keyboard": true,
    "rtl": true
  },
  "stages": [
    "hardware-profile",
    "nbit-policy",
    "compatibility-policy",
    "detect",
    "partition",
    "format",
    "copy",
    "boot",
    "configure",
    "verify",
    "reboot"
  ],
  "destructiveOperationsRequireConfirmation": true,
  "executionModes": [
    "auto-native",
    "manual-nbit",
    "wide-emulated",
    "compatibility"
  ],
  "mixedWidthIPC": {
    "enabled": true,
    "canonicalTransport": "width-neutral"
  },
  "installationModes": [
    "hosted",
    "emulator",
    "dual-boot",
    "bare-metal"
  ],
  "hosts": [
    "linux",
    "unix",
    "windows",
    "macos"
  ],
  "dualBoot": {
    "preserveExistingOS": true,
    "uefiFirst": true,
    "automaticErase": false,
    "automaticPartitioning": false
  },
  "hosted": {
    "backend": "qemu-system",
    "acceleratedWhenAvailable": true,
    "tcgFallback": true,
    "diskFormat": "qcow2"
  },
  "optionalEnterpriseServices": {
    "catalog": "services/enterprise-services.json",
    "installerTool": "tools/services/enterprise_service_installer.py",
    "profiles": [
      "directory-identity",
      "database",
      "web-platform",
      "observability",
      "container-platform",
      "file-and-print",
      "backup",
      "messaging",
      "network-edge",
      "email-platform",
      "security-and-time",
      "object-storage",
      "virtualization",
      "ci-runners"
    ],
    "defaultSelection": [],
    "bootTargetsEnabledOnlyAfterReview": true
  },
  "gpuProgramming": {
    "tool": "/usr/lib/chimera/tools/gpu/chimera_gpu_toolchain.py",
    "catalog": "/usr/share/chimera/isa/gpu_isa_registry.json",
    "selection": "optional",
    "requireDeviceProbe": true,
    "allowCpuFallbackOnlyForSupportedSemantics": true
  }
}
