{
  "schema": "CHIMERA-ENTERPRISE-SERVICES-1",
  "version": 1,
  "description": "Optional enterprise service bundles. Catalog entries are install intents; services are enabled only after explicit user selection and configuration.",
  "package_managers": [
    "apt-get",
    "dnf",
    "yum",
    "zypper",
    "pacman",
    "apk",
    "brew",
    "snap"
  ],
  "profiles": [
    {
      "id": "directory-identity",
      "label": "Directory and identity",
      "services": [
        "ldap",
        "kerberos",
        "sso"
      ],
      "default": false
    },
    {
      "id": "database",
      "label": "Database platform",
      "services": [
        "postgresql",
        "mariadb",
        "redis"
      ],
      "default": false
    },
    {
      "id": "web-platform",
      "label": "Web and reverse proxy",
      "services": [
        "nginx",
        "apache",
        "haproxy"
      ],
      "default": false
    },
    {
      "id": "observability",
      "label": "Monitoring and observability",
      "services": [
        "prometheus",
        "grafana",
        "loki"
      ],
      "default": false
    },
    {
      "id": "container-platform",
      "label": "Containers and orchestration",
      "services": [
        "containerd",
        "podman",
        "kubernetes-tools"
      ],
      "default": false
    },
    {
      "id": "file-and-print",
      "label": "Enterprise file and print",
      "services": [
        "samba",
        "cups",
        "openssh"
      ],
      "default": false
    },
    {
      "id": "backup",
      "label": "Backup and recovery",
      "services": [
        "restic",
        "borgbackup"
      ],
      "default": false
    },
    {
      "id": "messaging",
      "label": "Messaging and integration",
      "services": [
        "rabbitmq",
        "mosquitto"
      ],
      "default": false
    },
    {
      "id": "network-edge",
      "label": "Network edge and remote access",
      "services": [
        "bind9",
        "dhcp-server",
        "wireguard",
        "openvpn",
        "freeradius"
      ],
      "default": false
    },
    {
      "id": "email-platform",
      "label": "Enterprise email",
      "services": [
        "postfix",
        "dovecot"
      ],
      "default": false
    },
    {
      "id": "security-and-time",
      "label": "Security and time services",
      "services": [
        "chrony",
        "fail2ban",
        "vault"
      ],
      "default": false
    },
    {
      "id": "object-storage",
      "label": "Object storage",
      "services": [
        "minio"
      ],
      "default": false
    },
    {
      "id": "virtualization",
      "label": "Virtualization hosts",
      "services": [
        "libvirt",
        "qemu"
      ],
      "default": false
    },
    {
      "id": "ci-runners",
      "label": "CI runners",
      "services": [
        "gitlab-runner"
      ],
      "default": false
    }
  ],
