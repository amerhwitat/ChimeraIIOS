        ],
        "brew": [
          "postgresql@16"
        ],
        "snap": [
          "postgresql"
        ]
      },
      "native": "prefer-native-package",
      "compatibility": [
        "linux"
      ],
      "source": {
        "url": "https://ftp.postgresql.org/pub/source/v16.4/postgresql-16.4.tar.gz",
        "sha256_required": true,
        "build": [
          "./configure",
          "make",
