#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 2 ]] || { echo "Usage: chimera-iso-mount IMAGE.iso|/dev/sr0 MOUNTPOINT"; exit 2; }
src=$1; dst=$2
[[ $EUID -eq 0 ]] || { echo "Run as root (sudo)." >&2; exit 2; }
[[ -f "$src" || -b "$src" ]] || { echo "Source must be an ISO file or block device." >&2; exit 2; }
mkdir -p -- "$dst"
mountpoint -q -- "$dst" && { echo "Already mounted." >&2; exit 1; }
[[ -z "$(find "$dst" -mindepth 1 -maxdepth 1 -print -quit)" ]] || { echo "Mountpoint must be empty." >&2; exit 1; }
opts="ro,nosuid,nodev,noexec"; [[ -f "$src" ]] && opts="loop,$opts"
mount -t iso9660 -o "$opts" -- "$src" "$dst" && exit 0
mount -t udf -o "$opts" -- "$src" "$dst" && exit 0
echo "Could not mount as ISO9660 or UDF; source unchanged." >&2; exit 1
