{
  "schema": "CHM-COMMAND-CONFORMANCE-CASES-1",
  "scope": "Partial engineering cases executed against the real multicall binary. Not an official conformance suite.",
  "placeholders": {
    "{bindir}": "directory containing provider symlinks",
    "{workdir}": "temporary working directory with fixture files",
    "{cwd}": "runner working directory",
    "{sysname}": "host kernel name",
    "{nodename}": "host node name"
  },
  "cases": [
    {"id": "chimera-cmd-info", "command": "chimera-cmd", "args": [], "expected_stdout": "Chimera II native command runtime\nABI: native\nStatus: operational\n"},
    {"id": "pwd-current-directory", "command": "pwd", "args": [], "expected_stdout": "{workdir}\n"},
    {"id": "echo-argument-joining", "command": "echo", "args": ["hello", "world"], "expected_stdout": "hello world\n"},
    {"id": "true-exit-zero", "command": "true", "args": [], "expected_stdout": ""},
    {"id": "false-exit-one", "command": "false", "args": [], "expected_exit": 1, "expected_stdout": ""},
    {"id": "cat-file-bytes", "command": "cat", "args": ["{workdir}/sample.txt"], "expected_stdout": "alpha\nbeta\n"},
    {"id": "basename-with-suffix", "command": "basename", "args": ["/a/b/c.txt", ".txt"], "expected_stdout": "c\n"},
    {"id": "basename-trailing-slash", "command": "basename", "args": ["/a/b/"], "expected_stdout": "b\n"},
    {"id": "dirname-normal", "command": "dirname", "args": ["/a/b/c"], "expected_stdout": "/a/b\n"},
    {"id": "dirname-relative", "command": "dirname", "args": ["file"], "expected_stdout": ".\n"},
    {"id": "head-two-lines-stdin", "command": "head", "args": ["-n", "2"], "stdin": "one\ntwo\nthree\n", "expected_stdout": "one\ntwo\n"},
    {"id": "tail-one-line-stdin", "command": "tail", "args": ["-n", "1"], "stdin": "one\ntwo\nthree\n", "expected_stdout": "three\n"},
    {"id": "tail-from-line-stdin", "command": "tail", "args": ["-n", "+2"], "stdin": "one\ntwo\nthree\n", "expected_stdout": "two\nthree\n"},
    {"id": "wc-all-flags-stdin", "command": "wc", "args": ["-l", "-w", "-c"], "stdin": "a b\nc\n", "expected_stdout": "2 3 6\n"},
    {"id": "wc-default-stdin", "command": "wc", "args": [], "stdin": "x y z", "expected_stdout": "1 3 5\n"},
    {"id": "seq-simple", "command": "seq", "args": ["1", "3"], "expected_stdout": "1\n2\n3\n"},
    {"id": "seq-increment", "command": "seq", "args": ["2", "2", "6"], "expected_stdout": "2\n4\n6\n"},
    {"id": "seq-negative-increment", "command": "seq", "args": ["3", "-1", "1"], "expected_stdout": "3\n2\n1\n"},
    {"id": "sleep-zero", "command": "sleep", "args": ["0"], "expected_stdout": ""},
    {"id": "uname-kernel-name", "command": "uname", "args": ["-s"], "expected_stdout": "{sysname}\n"},
    {"id": "hostname-node-name", "command": "hostname", "args": [], "expected_stdout": "{nodename}\n"},
    {"id": "readlink-existing-symlink", "command": "readlink", "args": ["{workdir}/link"], "expected_stdout": "sample.txt\n"},
    {"id": "ln-symbolic", "command": "ln", "args": ["-s", "sample.txt", "{workdir}/link2"], "expected_stdout": ""},
    {"id": "readlink-created-symlink", "command": "readlink", "args": ["{workdir}/link2"], "expected_stdout": "sample.txt\n"},
    {"id": "rmdir-empty-directory", "command": "rmdir", "args": ["{workdir}/emptydir"], "expected_stdout": ""},
    {"id": "printenv-named-variable", "command": "printenv", "args": ["CHM_TEST_VALUE"], "env": {"CHM_TEST_VALUE": "measured"}, "expected_stdout": "measured\n"},
    {"id": "env-empty", "command": "env", "args": ["-i"], "expected_stdout": ""},
    {"id": "env-assignment-exec", "command": "env", "args": ["-i", "FOO=bar", "{bindir}/printenv", "FOO"], "expected_stdout": "bar\n"},
    {"id": "env-assignment-print", "command": "env", "args": ["-i", "FOO=bar"], "expected_stdout": "FOO=bar\n"},
    {"id": "clear-escape-sequence", "command": "clear", "args": [], "expected_stdout": "\u001b[2J\u001b[H"},
    {"id": "ls-lists-fixture", "command": "ls", "args": ["{workdir}"], "expected_stdout_contains": "sample.txt"},
    {"id": "cp-file", "command": "cp", "args": ["{workdir}/sample.txt", "{workdir}/copied.txt"], "expected_stdout": ""},
    {"id": "cat-copied-file", "command": "cat", "args": ["{workdir}/copied.txt"], "expected_stdout": "alpha\nbeta\n"},
    {"id": "mv-file", "command": "mv", "args": ["{workdir}/copied.txt", "{workdir}/moved.txt"], "expected_stdout": ""},
    {"id": "cat-moved-file", "command": "cat", "args": ["{workdir}/moved.txt"], "expected_stdout": "alpha\nbeta\n"},
    {"id": "touch-file", "command": "touch", "args": ["{workdir}/touched.txt"], "expected_stdout": ""},
    {"id": "wc-touched-file", "command": "wc", "args": ["-c", "{workdir}/touched.txt"], "expected_stdout": "0 {workdir}/touched.txt\n"},
    {"id": "mkdir-directory", "command": "mkdir", "args": ["{workdir}/newdir"], "expected_stdout": ""},
    {"id": "unknown-provider-fails-closed", "command": "not-a-real-provider", "args": [], "env": {"CHIMERA_DISABLE_COMPAT": "1"}, "expected_exit": 127, "expected_stdout": ""}
  ]
}
