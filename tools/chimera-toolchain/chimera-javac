#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "$0")/../.." && pwd)
BITS="${CHIMERA_BITS:-8192}"
command -v javac >/dev/null 2>&1 || { echo 'chimera-javac: javac not installed' >&2; exit 127; }
# Java bytecode is portable; native Chimera integration is supplied through the
# SDK module path and FFM/JNI bridge rather than pretending javac emits Chimera ISA.
exec javac -d "${CHIMERA_JAVA_OUT:-$ROOT/build/java}" -cp "${CHIMERA_JAVA_CP:-$ROOT/sdk/java}" -Dchimera.logical.bits="$BITS" "$@"
