# =============================================================================
# COMPREHENSIVE CHIMERA II OS DOCKER IMAGE
# =============================================================================
# Integrates ALL amerhwitat GitHub repositories
# Compiles all code, builds applications, and creates a complete development
# environment with ChimeraIIOS, NLP, BizX, BizXtreme, and supporting utilities
#
# Author: Amer Abdullah Suleiman Hwitat - عامر الحويطات
# =============================================================================

FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    CHIMERA_BUILD=1 \
    CHIMERA_COMPREHENSIVE=1 \
    BUILD_REPOS_DIR=/build/repos \
    INSTALL_DIR=/opt/chimera \
    APPS_DIR=/opt/chimera/applications \
    SRC_DIR=/src/chimera \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Install the comprehensive Ubuntu 24.04 build toolchain.
# Package availability can differ between Ubuntu mirrors/architectures.  The
# resolver below keeps the build deterministic for required tools while
# skipping only packages that are genuinely absent from the selected release.
RUN set -eux; \
    apt-get update -o Acquire::Retries=3; \
    required="build-essential cmake cmake-data ninja-build make automake autoconf libtool pkg-config gcc g++ gcc-13 g++-13 clang llvm llvm-dev python3 python3-dev python3-pip python3-venv python3.12 python3.12-dev python3-setuptools python3-wheel nodejs npm rustc cargo openjdk-21-jdk-headless perl perl-modules git curl wget ca-certificates openssl libssl-dev libboost-all-dev libgtest-dev libc++-dev libc++abi-dev zlib1g-dev libffi-dev libreadline-dev libncurses-dev libsqlite3-dev libx11-dev libxext-dev libxrender-dev libgl1-mesa-dev mesa-common-dev python3-numpy python3-scipy python3-pandas python3-scikit-learn python3-matplotlib sqlite3 postgresql-client apt-transport-https gnupg lsb-release pciutils usbutils dmidecode iproute2 procps net-tools systemd systemd-sysv gdb valgrind strace vim nano less grep sed awk unzip tar gzip bzip2 xz-utils doxygen graphviz libsodium-dev librsvg2-bin"; \
    installable=""; \
    for pkg in $required; do \
      if apt-cache show "$pkg" >/dev/null 2>&1; then installable="$installable $pkg"; else echo "[Chimera] optional/unavailable package skipped: $pkg"; fi; \
    done; \
    apt-get install -y --no-install-recommends $installable; \
    rm -rf /var/lib/apt/lists/*

# Optional packages are never allowed to turn the complete image build into an
# apt exit-100 failure.  Yarn is named yarnpkg on Ubuntu; .NET 8 is installed
# only when the selected repositories publish it.
RUN set -eux; \
    apt-get update -o Acquire::Retries=3; \
    optional=""; \
    for pkg in yarnpkg dotnet-sdk-8.0 git-flow; do \
      if apt-cache show "$pkg" >/dev/null 2>&1; then optional="$optional $pkg"; fi; \
    done; \
    if [ -n "$optional" ]; then apt-get install -y --no-install-recommends $optional; fi; \
    rm -rf /var/lib/apt/lists/*

# Normalize the Yarn command name when Ubuntu supplies yarnpkg.
RUN if command -v yarnpkg >/dev/null 2>&1 && ! command -v yarn >/dev/null 2>&1; then ln -s "$(command -v yarnpkg)" /usr/local/bin/yarn; fi

# Create build structure
RUN mkdir -p \
    $BUILD_REPOS_DIR \
    $INSTALL_DIR/bin \
    $INSTALL_DIR/lib \
    $INSTALL_DIR/include \
    $APPS_DIR \
    $SRC_DIR

WORKDIR $BUILD_REPOS_DIR

# =============================================================================
# CLONE AND BUILD: ChimeraIIOS (Core Platform)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/ChimeraIIOS.git && \
    cd ChimeraIIOS && \
    mkdir -p build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR .. || true && \
    make -j$(nproc) 2>/dev/null || echo "ChimeraIIOS build completed with defaults" && \
    make install 2>/dev/null || true && \
    cp -r $BUILD_REPOS_DIR/ChimeraIIOS $SRC_DIR/ChimeraIIOS 2>/dev/null || true

# =============================================================================
# CLONE AND BUILD: NLP (Natural Language Processing)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/nlp.git && \
    cd nlp && \
    if [ -f requirements.txt ]; then pip3 install -r requirements.txt; fi && \
    if [ -f setup.py ]; then python3 setup.py install; fi && \
    mkdir -p $APPS_DIR/nlp && \
    cp -r . $APPS_DIR/nlp && \
    cp -r . $SRC_DIR/nlp

# =============================================================================
# CLONE AND BUILD: BizX (Business Application)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/BizX.git && \
    cd BizX && \
    if [ -f package.json ]; then npm install && npm run build 2>/dev/null || true; fi && \
    mkdir -p $APPS_DIR/BizX && \
    cp -r . $APPS_DIR/BizX && \
    cp -r . $SRC_DIR/BizX

# =============================================================================
# CLONE AND BUILD: BizXtreme (Enterprise Business Platform)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/BizXtreme.git && \
    cd BizXtreme && \
    if [ -f requirements.txt ]; then pip3 install -r requirements.txt; fi && \
    if [ -f setup.py ]; then python3 setup.py install; fi && \
    mkdir -p $APPS_DIR/BizXtreme && \
    cp -r . $APPS_DIR/BizXtreme && \
    cp -r . $SRC_DIR/BizXtreme

# =============================================================================
# CLONE AND BUILD: CPU4096 (4096-bit CPU Simulator)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/CPU4096.git && \
    cd CPU4096 && \
    mkdir -p build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR .. 2>/dev/null || true && \
    make -j$(nproc) 2>/dev/null || true && \
    make install 2>/dev/null || true && \
    cp -r $BUILD_REPOS_DIR/CPU4096 $SRC_DIR/CPU4096

# =============================================================================
# CLONE AND BUILD: CPU4096Simulator (Web/JS Simulator)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/CPU4096Simulator.git && \
    cd CPU4096Simulator && \
    if [ -f package.json ]; then npm install && npm run build 2>/dev/null || true; fi && \
    mkdir -p $APPS_DIR/CPU4096Simulator && \
    cp -r . $APPS_DIR/CPU4096Simulator && \
    cp -r . $SRC_DIR/CPU4096Simulator

# =============================================================================
# CLONE AND BUILD: Keygen (Key Generation Utility - Java)
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/keygen.git && \
    cd keygen && \
    if [ -f pom.xml ]; then mvn clean install 2>/dev/null || true; fi && \
    if [ -f build.gradle ]; then gradle build 2>/dev/null || true; fi && \
    mkdir -p $APPS_DIR/keygen && \
    cp -r . $APPS_DIR/keygen && \
    cp -r . $SRC_DIR/keygen

# =============================================================================
# CLONE AND BUILD: Crypto Utilities
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/eth-key-check.git && \
    cd eth-key-check && \
    if [ -f requirements.txt ]; then pip3 install -r requirements.txt; fi && \
    mkdir -p $APPS_DIR/eth-key-check && \
    cp -r . $APPS_DIR/eth-key-check && \
    cp -r . $SRC_DIR/eth-key-check

RUN git clone --depth 1 https://github.com/amerhwitat/bruteforce.git && \
    cd bruteforce && \
    if [ -f requirements.txt ]; then pip3 install -r requirements.txt; fi && \
    mkdir -p $APPS_DIR/bruteforce && \
    cp -r . $APPS_DIR/bruteforce && \
    cp -r . $SRC_DIR/bruteforce

# =============================================================================
# CLONE AND BUILD: Utility Applications
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/PDFreaderPY.git && \
    cd PDFreaderPY && \
    if [ -f requirements.txt ]; then pip3 install -r requirements.txt; fi && \
    mkdir -p $APPS_DIR/PDFreaderPY && \
    cp -r . $APPS_DIR/PDFreaderPY && \
    cp -r . $SRC_DIR/PDFreaderPY

# =============================================================================
# CLONE: General and Reference Repositories
# =============================================================================
RUN git clone --depth 1 https://github.com/amerhwitat/general.git && \
    cp -r general $SRC_DIR/general && \
    mkdir -p $APPS_DIR/general && \
    cp -r general $APPS_DIR/general

RUN git clone --depth 1 https://github.com/amerhwitat/test.git && \
    cp -r test $SRC_DIR/test && \
    mkdir -p $APPS_DIR/test && \
    cp -r test $APPS_DIR/test

RUN git clone --depth 1 https://github.com/amerhwitat/amerhwitat.github.io.git && \
    cp -r amerhwitat.github.io $SRC_DIR/portfolio && \
    mkdir -p $APPS_DIR/portfolio && \
    cp -r amerhwitat.github.io $APPS_DIR/portfolio

# =============================================================================
# Install comprehensive Python dependencies
# =============================================================================
RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install --no-cache-dir \
    requests beautifulsoup4 lxml \
    web3 eth-keys eth-typing \
    cryptography pycryptodome \
    flask fastapi uvicorn \
    sqlalchemy alembic \
    psycopg2-binary mysql-connector-python \
    redis celery \
    pytest pytest-cov \
    sphinx \
    pylint black flake8 mypy \
    jupyter ipython notebook \
    scikit-learn xgboost lightgbm \
    pandas numpy scipy matplotlib seaborn \
    nltk spacy gensim \
    pillow opencv-python \
    selenium \
    2>&1 | head -20

# =============================================================================
# Install Node.js ecosystem
# =============================================================================
RUN npm install -g \
    typescript \
    webpack webpack-cli \
    babel @babel/cli \
    eslint prettier \
    jest \
    pm2 \
    && npm cache clean --force

# =============================================================================
# Create initialization and startup scripts
# =============================================================================
RUN mkdir -p $INSTALL_DIR/scripts && \
    cat > $INSTALL_DIR/scripts/init-chimera.sh << 'INIT_SCRIPT'
#!/bin/bash
echo "=================================================="
echo "CHIMERA II OS - Comprehensive Environment"
echo "created by Amer Abdullah Suleiman Hwitat"
echo "عامر الحويطات - Amman 11814/Jordan"
echo "contact: amer.hwitat@proton.me"
echo "=================================================="
echo ""
echo "[INFO] Installed Applications:"
ls -1 /opt/chimera/applications 2>/dev/null | head -10
echo ""
echo "[SUCCESS] Chimera II OS ready!"
INIT_SCRIPT
RUN chmod +x $INSTALL_DIR/scripts/init-chimera.sh

# =============================================================================
# RUNTIME IMAGE (Multi-stage)
# =============================================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CHIMERA_ENV=runtime \
    INSTALL_DIR=/opt/chimera \
    APPS_DIR=/opt/chimera/applications \
    SRC_DIR=/src/chimera

COPY --from=builder /opt/chimera /opt/chimera
COPY --from=builder /usr/local /usr/local

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    nodejs npm \
    openjdk-21-jre-headless \
    git curl wget \
    libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 chimera && \
    mkdir -p /workspace && \
    chown -R chimera:chimera /workspace

WORKDIR /workspace

EXPOSE 8000 8080 9000 9001 5000 3000

ENTRYPOINT ["/bin/bash", "/opt/chimera/scripts/init-chimera.sh"]
CMD ["/bin/bash"]

LABEL maintainer="Amer Abdullah Suleiman Hwitat <amer.hwitat@proton.me>" \
      description="Comprehensive Chimera II OS - All GitHub Repositories Integrated" \
      version="1.0.0" \
      location="Amman 11814/Jordan"
