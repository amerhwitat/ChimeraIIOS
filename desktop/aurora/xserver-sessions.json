{
  "schema": "CHIMERA-AURORA-XSERVER-SESSIONS-1",
  "x_server": {
    "implementation": "X.Org X Server",
    "binary": "/usr/bin/Xorg",
    "launcher": "/usr/local/bin/chimera-xserver-session",
    "session_registry": ["/usr/local/share/xsessions", "/usr/share/xsessions"],
    "network_listening": false,
    "startx_server_arguments": [":0", "-nolisten", "tcp", "-noreset"]
  },
  "aurora_fallback_session": {
    "id": "chimera-aurora-x11",
    "desktop_file": "/usr/share/xsessions/chimera-aurora-x11.desktop",
    "command": "/usr/local/bin/aurora-x11-session",
    "window_manager": "openbox-session",
    "web_shell": "/usr/local/bin/aurora-kiosk.py"
  },
  "policy": "Discover and launch only installed XDG X11 session desktop files. Missing session binaries remain unavailable; no dummy session is generated. Wayland sessions remain owned by their compositor and are not launched inside X.Org."
}
