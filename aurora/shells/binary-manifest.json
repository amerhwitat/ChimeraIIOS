{
  "schema_version": 1,
  "architecture_policy": [
    "linux-amd64",
    "linux-i386",
    "linux-armel",
    "linux-armhf",
    "linux-arm64",
    "linux-riscv64",
    "linux-ppc64le",
    "linux-s390x"
  ],
  "acquisition": "Prefer verified target-distribution packages; compile source-built fallback providers from recorded upstream commits and verify ELF machine type and SHA-256. Never create placeholder shells.",
  "shells": {
    "bash": {
      "source": "https://git.savannah.gnu.org/git/bash.git/",
      "build": "autotools",
      "license": "GPL-3.0-or-later"
    },
    "zsh": {
      "source": "https://github.com/zsh-users/zsh",
      "build": "autotools",
      "license": "Zsh-license-with-GPL-components"
    },
    "fish": {
      "source": "https://github.com/fish-shell/fish-shell",
      "build": "cmake/cargo",
      "license": "GPL/LGPL/MIT/PSF"
    },
    "dash": {
      "source": "https://git.kernel.org/pub/scm/utils/dash/dash.git/",
      "build": "autotools",
      "license": "BSD-3-Clause"
    },
    "mksh": {
      "source": "https://github.com/MirBSD/mksh",
      "build": "make",
      "license": "MirOS"
    },
    "yash": {
      "source": "https://github.com/magicant/yash",
      "build": "configure/make",
      "license": "GPL-2.0-or-later"
    },
    "elvish": {
      "source": "https://github.com/elves/elvish",
      "build": "go",
      "license": "BSD-2-Clause-with-component-exceptions"
    },
    "nushell": {
      "source": "https://github.com/nushell/nushell",
      "build": "cargo-or-release",
      "license": "MIT"
    }
  },
  "note": "The target-rootfs terminal-shell suite records per-provider package/source status and runs shell command or terminal version smoke tests. Linux provider tests do not establish Koronos ABI compatibility."
}
