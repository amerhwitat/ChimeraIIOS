[Unit]
Description=Aurora Wayland Desktop Session
Documentation=https://github.com/amerhwitat/ChimeraIIOS
Requires=chimera-kernel.service
After=chimera-kernel.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=%i
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Aurora
Environment=XDG_SESSION_DESKTOP=aurora
ExecStart=/usr/lib/chimera/aurora-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
